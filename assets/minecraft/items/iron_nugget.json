                "fallback": {
                  "type": "minecraft:model",
                  "model": "minted_coins:item/iron_coin_pile_small"
                }
              }
            },
            {
              "threshold": 32,
              "model": {
                "type": "minecraft:select",
                "property": "minecraft:display_context",
                "cases": [
                  {
                    "when": "gui",
                    "model": {
                      "type": "minecraft:model",
                      "model": "minted_coins:item/iron_coin_pile_large_icon"
                    }
                  }
                ],
                "fallback": {
                  "type": "minecraft:model",
                  "model": "minted_coins:item/iron_coin_pile_large"
                }
              }
            },
            {
              "threshold": 60,
              "model": {
                "type": "minecraft:select",
                "property": "minecraft:display_context",
                "cases": [
                  {
                    "when": "gui",
                    "model": {
